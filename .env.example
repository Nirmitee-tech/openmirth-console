# Mirth Connect REST API endpoint
MIRTH_URL=https://localhost:8443
MIRTH_USER=admin
MIRTH_PASS=admin

# Mirth serves HTTPS with a self-signed cert by default. Pick ONE approach:
#
#   A) PRODUCTION (required):
#      Export Mirth's CA / cert to a file and point to it.
#      The fetch agent will validate Mirth's cert against this trust anchor —
#      no system trust-store changes required.
#
#      MIRTH_CA_FILE=/etc/openmirth-console/mirth-ca.pem
#
#   B) LOCAL DEV ONLY (never set in production):
#      Skip cert verification for the Mirth connection only (NOT global).
#      Leave unset by default. Setting this opens you up to MITM on the
#      Mirth REST channel, so use exclusively against localhost / known-good
#      docker networks during initial setup.
#
#      MIRTH_INSECURE_SKIP_VERIFY=true

# Role mapping (REQUIRED — server-side authorization).
#
# Comma-separated usernames per tier. A user not listed in any tier is
# DENIED login (closed-world default — principle of least privilege).
# Use "*" to grant a tier to every authenticated user.
#
# Most-privileged tier wins: a user listed in both admin and viewer
# gets admin. Username comparison is case-insensitive.
#
# Example for the local docker-compose demo (Mirth's bootstrap admin):
OMCC_ROLE_ADMIN=admin
OMCC_ROLE_OPERATOR=
OMCC_ROLE_VIEWER=

# Production example:
#   OMCC_ROLE_ADMIN=alice,bob
#   OMCC_ROLE_OPERATOR=charlie,dave,eve
#   OMCC_ROLE_VIEWER=*

# Optional: embed Grafana + interface catalog
# Point these at the running services from the
# hospital-operations-dashboard cookbook recipe.
GRAFANA_URL=http://localhost:3001
CATALOG_URL=http://localhost:8000
